# WorkHub Server Environment Configuration Template

# Server Environment & Port
PORT=5000
NODE_ENV=development

# Database Configuration
# Option A: Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/workhub

# Option B: MongoDB Atlas cloud cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.etprdfz.mongodb.net/workhub?retryWrites=true&w=majority

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production_32_chars_min
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_in_production

# Frontend Client URL (Used for CORS whitelisting & invitation redirects)
CLIENT_URL=http://localhost:5173
# Production Client URL Example:
# CLIENT_URL=https://workhub-platform.vercel.app

# Optional Cloudinary Storage (For file and profile attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
