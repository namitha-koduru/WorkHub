# WorkHub Client Environment Configuration Example

# Local development defaults (automatically proxied by Vite dev server):
VITE_API_URL=/api/v1
VITE_SOCKET_URL=/

# Production deployment example (Vercel pointing to Render backend):
# VITE_API_URL=https://workhub-api.onrender.com/api/v1
# VITE_SOCKET_URL=https://workhub-api.onrender.com
